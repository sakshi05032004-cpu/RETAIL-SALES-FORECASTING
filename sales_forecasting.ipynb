# RETAIL SALES FORECASTING USING MACHINE LEARNING
# ============================================================

# ============================================================
# 1. IMPORT LIBRARIES
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
from sklearn.pipeline import Pipeline

from sklearn.linear_model import LinearRegression
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor

from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

import warnings
warnings.filterwarnings("ignore")


# ============================================================
# 2. LOAD DATASET
# ============================================================

df = pd.read_csv("../data/retail_sales.csv")

print("Dataset loaded successfully!")
print("Shape:", df.shape)

print("\nFirst 5 rows:")
print(df.head())


# ============================================================
# 3. BASIC DATA INFORMATION
# ============================================================

print("\nDataset Information:")
print(df.info())

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Rows:")
print(df.duplicated().sum())

print("\nStatistical Summary:")
print(df.describe())


# ============================================================
# 4. DATA CLEANING
# ============================================================

df["Date"] = pd.to_datetime(df["Date"])

# Remove duplicate rows
df = df.drop_duplicates()

# Remove missing values
df = df.dropna()

# Sort by date
df = df.sort_values("Date").reset_index(drop=True)

print("\nData after cleaning:")
print(df.shape)


# ============================================================
# 5. EXPLORATORY DATA ANALYSIS
# ============================================================

# Daily sales
daily_sales = df.groupby("Date")["Sales"].sum()

plt.figure(figsize=(14, 5))
plt.plot(daily_sales)
plt.title("Daily Retail Sales")
plt.xlabel("Date")
plt.ylabel("Sales")
plt.grid(True)
plt.show()


# ============================================================
# 6. MONTHLY SALES
# ============================================================

monthly_sales = df.groupby(
    df["Date"].dt.to_period("M")
)["Sales"].sum()

plt.figure(figsize=(14, 5))
plt.plot(
    monthly_sales.index.astype(str),
    monthly_sales.values
)

plt.title("Monthly Sales Trend")
plt.xlabel("Month")
plt.ylabel("Sales")
plt.xticks(rotation=90)
plt.grid(True)
plt.show()


# ============================================================
# 7. SALES BY CATEGORY
# ============================================================

category_sales = (
    df.groupby("Category")["Sales"]
    .sum()
    .sort_values(ascending=False)
)

plt.figure(figsize=(10, 5))
category_sales.plot(kind="bar")

plt.title("Sales by Category")
plt.xlabel("Category")
plt.ylabel("Total Sales")
plt.xticks(rotation=45)
plt.show()


# ============================================================
# 8. SALES BY STORE
# ============================================================

store_sales = (
    df.groupby("Store_ID")["Sales"]
    .sum()
    .sort_values(ascending=False)
)

plt.figure(figsize=(10, 5))
store_sales.plot(kind="bar")

plt.title("Sales by Store")
plt.xlabel("Store")
plt.ylabel("Total Sales")
plt.show()


# ============================================================
# 9. FEATURE ENGINEERING
# ============================================================

df["Year"] = df["Date"].dt.year
df["Month"] = df["Date"].dt.month
df["Day"] = df["Date"].dt.day
df["DayOfWeek"] = df["Date"].dt.dayofweek
df["Quarter"] = df["Date"].dt.quarter

df["WeekOfYear"] = (
    df["Date"].dt.isocalendar().week.astype(int)
)

df["IsWeekend"] = (
    df["DayOfWeek"] >= 5
).astype(int)


# ============================================================
# 10. CREATE LAG FEATURES
# ============================================================

df = df.sort_values(
    ["Store_ID", "Category", "Date"]
)

group = df.groupby(
    ["Store_ID", "Category"]
)["Sales"]

df["Lag_1_Sales"] = group.shift(1)
df["Lag_7_Sales"] = group.shift(7)
df["Lag_30_Sales"] = group.shift(30)


# ============================================================
# 11. CREATE ROLLING FEATURES
# ============================================================

df["Rolling_7_Sales"] = (
    df.groupby(
        ["Store_ID", "Category"]
    )["Sales"]
    .transform(
        lambda x: x.shift(1).rolling(7).mean()
    )
)

df["Rolling_30_Sales"] = (
    df.groupby(
        ["Store_ID", "Category"]
    )["Sales"]
    .transform(
        lambda x: x.shift(1).rolling(30).mean()
    )


# ============================================================
# 12. REMOVE ROWS WITH MISSING LAG VALUES
# ============================================================

df = df.dropna().reset_index(drop=True)

print("\nDataset after feature engineering:")
print(df.shape)


# ============================================================
# 13. SELECT FEATURES
# ============================================================

features = [
    "Store_ID",
    "Category",
    "Units_Sold",
    "Unit_Price",
    "Discount_Percent",
    "Promotion",
    "Holiday",
    "Year",
    "Month",
    "Day",
    "DayOfWeek",
    "Quarter",
    "WeekOfYear",
    "IsWeekend",
    "Lag_1_Sales",
    "Lag_7_Sales",
    "Lag_30_Sales",
    "Rolling_7_Sales",
    "Rolling_30_Sales"
]

X = df[features]
y = df["Sales"]


# ============================================================
# 14. TIME-BASED TRAIN TEST SPLIT
# ============================================================

# 80% historical data for training
# 20% recent data for testing

split_date = df["Date"].quantile(0.8)

train = df[df["Date"] <= split_date]
test = df[df["Date"] > split_date]

X_train = train[features]
y_train = train["Sales"]

X_test = test[features]
y_test = test["Sales"]

print("\nTraining rows:", len(train))
print("Testing rows:", len(test))
print("Split date:", split_date)


# ============================================================
# 15. PREPROCESSING
# ============================================================

categorical_features = [
    "Store_ID",
    "Category"
]

numeric_features = [
    "Units_Sold",
    "Unit_Price",
    "Discount_Percent",
    "Promotion",
    "Holiday",
    "Year",
    "Month",
    "Day",
    "DayOfWeek",
    "Quarter",
    "WeekOfYear",
    "IsWeekend",
    "Lag_1_Sales",
    "Lag_7_Sales",
    "Lag_30_Sales",
    "Rolling_7_Sales",
    "Rolling_30_Sales"
]

preprocessor = ColumnTransformer(
    transformers=[
        (
            "cat",
            OneHotEncoder(handle_unknown="ignore"),
            categorical_features
        )
    ],
    remainder="passthrough"
)


# ============================================================
# 16. LINEAR REGRESSION
# ============================================================

linear_model = Pipeline([
    ("preprocessor", preprocessor),
    ("model", LinearRegression())
])

linear_model.fit(X_train, y_train)

linear_pred = linear_model.predict(X_test)


# ============================================================
# 17. DECISION TREE
# ============================================================

tree_model = Pipeline([
    ("preprocessor", preprocessor),
    (
        "model",
        DecisionTreeRegressor(
            max_depth=15,
            random_state=42
        )
    )
])

tree_model.fit(X_train, y_train)

tree_pred = tree_model.predict(X_test)


# ============================================================
# 18. RANDOM FOREST
# ============================================================

rf_model = Pipeline([
    ("preprocessor", preprocessor),
    (
        "model",
        RandomForestRegressor(
            n_estimators=100,
            max_depth=15,
            random_state=42,
            n_jobs=-1
        )
    )
])

rf_model.fit(X_train, y_train)

rf_pred = rf_model.predict(X_test)


# ============================================================
# 19. MODEL EVALUATION FUNCTION
# ============================================================

def evaluate_model(name, actual, predicted):

    mae = mean_absolute_error(
        actual,
        predicted
    )

    rmse = np.sqrt(
        mean_squared_error(
            actual,
            predicted
        )
    )

    r2 = r2_score(
        actual,
        predicted
    )

    print("\n", name)
    print("-" * 40)
    print("MAE :", round(mae, 2))
    print("RMSE:", round(rmse, 2))
    print("R²  :", round(r2, 4))

    return [
        name,
        mae,
        rmse,
        r2
    ]


# ============================================================
# 20. EVALUATE ALL MODELS
# ============================================================

results = []

results.append(
    evaluate_model(
        "Linear Regression",
        y_test,
        linear_pred
    )
)

results.append(
    evaluate_model(
        "Decision Tree",
        y_test,
        tree_pred
    )
)

results.append(
    evaluate_model(
        "Random Forest",
        y_test,
        rf_pred
    )
)


# ============================================================
# 21. MODEL COMPARISON
# ============================================================

results_df = pd.DataFrame(
    results,
    columns=[
        "Model",
        "MAE",
        "RMSE",
        "R2"
    ]
)

print("\nModel Comparison:")
print(results_df.sort_values("RMSE"))


# ============================================================
# 22. SELECT BEST MODEL
# ============================================================

best_model_name = results_df.loc[
    results_df["RMSE"].idxmin(),
    "Model"
]

print(
    "\nBest Model:",
    best_model_name
)


# ============================================================
# 23. USE RANDOM FOREST FOR FORECAST
# ============================================================

comparison = test[
    [
        "Date",
        "Store_ID",
        "Category",
        "Sales"
    ]
].copy()

comparison["Predicted_Sales"] = rf_pred

print("\nActual vs Predicted:")
print(comparison.head())


# ============================================================
# 24. ACTUAL VS PREDICTED DAILY SALES
# ============================================================

daily_actual = (
    comparison
    .groupby("Date")["Sales"]
    .sum()
)

daily_predicted = (
    comparison
    .groupby("Date")["Predicted_Sales"]
    .sum()
)

plt.figure(figsize=(15, 6))

plt.plot(
    daily_actual.index,
    daily_actual.values,
    label="Actual Sales"
)

plt.plot(
    daily_predicted.index,
    daily_predicted.values,
    label="Predicted Sales"
)

plt.title(
    "Actual vs Predicted Retail Sales"
)

plt.xlabel("Date")
plt.ylabel("Sales")

plt.legend()
plt.grid(True)
plt.show()


# ============================================================
# 25. FORECAST ERROR
# ============================================================

comparison["Error"] = (
    comparison["Sales"]
    - comparison["Predicted_Sales"]
)

comparison["Absolute_Error"] = (
    abs(comparison["Error"])
)

comparison["Percentage_Error"] = (
    comparison["Absolute_Error"]
    / comparison["Sales"]
) * 100


# ============================================================
# 26. FORECAST ACCURACY
# ============================================================

forecast_accuracy = (
    100
    - comparison["Percentage_Error"].mean()
)

print(
    "\nForecast Accuracy:",
    round(forecast_accuracy, 2),
    "%"
)


# ============================================================
# 27. MONTHLY FORECAST
# ============================================================

comparison["Month"] = (
    comparison["Date"]
    .dt.to_period("M")
)

monthly_forecast = (
    comparison
    .groupby("Month")
    .agg(
        Actual_Sales=("Sales", "sum"),
        Predicted_Sales=(
            "Predicted_Sales",
            "sum"
        )
    )
    .reset_index()
)

print("\nMonthly Forecast:")
print(monthly_forecast)


# ============================================================
# 28. MONTHLY ACTUAL VS PREDICTED
# ============================================================

plt.figure(figsize=(14, 6))

plt.plot(
    monthly_forecast["Month"].astype(str),
    monthly_forecast["Actual_Sales"],
    marker="o",
    label="Actual"
)

plt.plot(
    monthly_forecast["Month"].astype(str),
    monthly_forecast["Predicted_Sales"],
    marker="o",
    label="Predicted"
)

plt.title(
    "Monthly Actual vs Forecasted Sales"
)

plt.xlabel("Month")
plt.ylabel("Sales")

plt.xticks(rotation=90)

plt.legend()
plt.grid(True)
plt.show()


# ============================================================
# 29. SAVE FORECAST RESULTS
# ============================================================

comparison.to_csv(
    "../data/sales_forecast_results.csv",
    index=False
)

monthly_forecast.to_csv(
    "../data/monthly_sales_forecast.csv",
    index=False
)

results_df.to_csv(
    "../data/model_comparison.csv",
    index=False
)

print(
    "\nForecast files saved successfully!"
)


# ============================================================
# 30. FINAL PROJECT SUMMARY
# ============================================================

print("\n")
print("=" * 50)
print("RETAIL SALES FORECASTING COMPLETED")
print("=" * 50)

print(
    "Best Model:",
    best_model_name
)

best_result = results_df[
    results_df["Model"] == best_model_name
].iloc[0]

print(
    "MAE:",
    round(best_result["MAE"], 2)
)

print(
    "RMSE:",
    round(best_result["RMSE"], 2)
)

print(
    "R² Score:",
    round(best_result["R2"], 4)
)

print(
    "Forecast Accuracy:",
    round(forecast_accuracy, 2),
    "%"
)
